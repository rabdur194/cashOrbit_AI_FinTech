POSTGRES_DB=cashorbit
POSTGRES_USER=cashorbit
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://cashorbit:change-me@db:5432/cashorbit
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_EXPIRE_MINUTES=720
NEXT_PUBLIC_API_URL=http://localhost:8000
# Hosted payment gateways. Keep these credentials private. Sandbox only by default.
PAYMENT_PROVIDER_MODE=sandbox
PAYMENT_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
# For provider callbacks/IPN from the internet, set PAYMENT_PUBLIC_BASE_URL to a public HTTPS URL
# from a development tunnel or deployed API. Do not use localhost for server-to-server IPN delivery.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Optional AI finance assistant. Keep the API key private; blank enables demo fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
