# ============================================================
# CashOrbit — Environment Variables (example only)
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# ============================================================

# --- Database ---
POSTGRES_DB=cashorbit
POSTGRES_USER=cashorbit
POSTGRES_PASSWORD=change-this-to-a-strong-password
DATABASE_URL=postgresql+psycopg://cashorbit:change-this-to-a-strong-password@db:5432/cashorbit

# --- Security (REQUIRED to change) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720

# --- CORS & URLs ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000
PAYMENT_PUBLIC_BASE_URL=http://localhost:8000

# --- Frontend (also set in Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Payments (sandbox only) ---
PAYMENT_PROVIDER_MODE=sandbox
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# --- AI Assistant (optional) ---
# Leave empty to use the built-in deterministic fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
